# ==============================================================================
# Enterprise-RAG Backend Environment Configuration Template
# Copy to .env and provide real credentials for your environment.
# Never commit real secrets or credentials to source control.
# ==============================================================================

# Application Environment
# APP_ENV: "development" | "staging" | "production"
# In "production" or "staging", strict security gating is enforced at startup:
# - API_KEY_AUTH_ENABLED must be true
# - ADMIN_API_TOKEN, API_AUTH_TOKEN, or API_TOKENS_MAPPING must be configured
APP_NAME=EnterpriseRAG
APP_ENV=development
DEBUG=false
PORT=8000

# Authentication & Multi-Tenancy
API_KEY_AUTH_ENABLED=false
ADMIN_API_TOKEN=change_me_super_admin_secret_token_min_32_chars
API_AUTH_TOKEN=change_me_service_client_token_min_32_chars
# Optional: JSON mapping for multiple tenant tokens
# API_TOKENS_MAPPING={"token_123": {"tenant_id": "tenant-alpha", "user_id": "alice", "roles": ["user"], "allowed_tenants": ["tenant-alpha"]}}
DEFAULT_TENANT_ID=default

# Reverse Proxy Security
# Comma-separated list of trusted upstream proxy IPs/CIDRs (e.g. Render/Cloudflare/ALB).
# X-Forwarded-For is only trusted when the immediate peer IP is listed here.
TRUSTED_PROXIES=127.0.0.1,::1

# Privacy & PII Detection
PII_DETECTION_ENABLED=true

# CORS Allowed Origins (comma-separated for custom domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Embedding Provider: "local" (BAAI/bge-small-en-v1.5, CPU, zero cost, 384 dimensions)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=8

# Weaviate Cloud (WCS)
WEAVIATE_URL=https://your-cluster-id.weaviate.cloud
WEAVIATE_API_KEY=your_weaviate_api_key_here

# Supabase PostgreSQL (or any PostgreSQL 14+ database)
DATABASE_URL=postgresql://postgres:your_db_password_here@db.your_project.supabase.co:5432/postgres

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Redis (optional; semantic cache & rate limiter fail open safely if unconfigured)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# LLM Configuration: Groq (Primary) with Ollama (Fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=768

# LLM Fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Vision Provider: "gemini" (cloud, recommended) | "disabled"
VISION_PROVIDER=disabled

# Gemini Cloud Vision — required when VISION_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-2.5-flash

# Vision pipeline tuning (Free-tier: 5 RPM -> concurrency=1, interval=12.0; Paid: concurrency=2-4, interval=0.0)
VISION_MAX_CONCURRENCY=1
VISION_MIN_REQUEST_INTERVAL=12.0
VISION_REQUEST_TIMEOUT=120
VISION_MAX_RETRIES=3
VISION_MAX_IMAGE_DIMENSION=1536
VISION_CACHE_DIR=./data/processed/vision_cache
INGESTION_TIMEOUT_VISION=10800

# Ingestion Controls
MAX_UPLOAD_SIZE_MB=100
INGESTION_TIMEOUT_SECONDS=1800
PARSE_PROFILE=BALANCED

# Storage Paths
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
#   Defaults to relative directories under ./data/
#
# RENDER PRODUCTION DEPLOYMENT:
#   Render's default filesystem is EPHEMERAL: files stored on ephemeral disk are
#   wiped on every restart, sleep/wake, or redeploy.
#   To persist uploaded PDFs across container restarts on Render:
#   1. Add a Persistent Disk to your Web Service in the Render Dashboard:
#      - Mount Path: /data
#      - Size: 1 GB or larger
#   2. Set these environment variables in your Render Environment:
#      RAW_STORAGE_PATH=/data/raw
#      PROCESSED_STORAGE_PATH=/data/processed
#      CHUNKS_STORAGE_PATH=/data/chunks
# ------------------------------------------------------------------------------
RAW_STORAGE_PATH=./data/raw
PROCESSED_STORAGE_PATH=./data/processed
CHUNKS_STORAGE_PATH=./data/chunks
