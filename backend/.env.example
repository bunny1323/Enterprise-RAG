# Application
APP_NAME=EnterpriseRAG
DEBUG=true
PORT=8000

# Embedding Provider: "local" (BAAI/bge-small-en-v1.5, CPU, zero cost, 384 dimensions)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=8

# Weaviate Cloud (WCS)
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=your_weaviate_api_key

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[password]@db.xxxxxxx.supabase.co:5432/postgres

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Redis (optional; caching disabled cleanly when unavailable)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# LLM Configuration: Groq (Primary) with Ollama (Fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=768

# Ollama Fallback & Vision Model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llava:13b
OLLAMA_TIMEOUT=15

# Ingestion Controls
MAX_UPLOAD_SIZE_MB=100
INGESTION_TIMEOUT_SECONDS=1800
PARSE_PROFILE=BALANCED

# Local Storage Paths
RAW_STORAGE_PATH=./data/raw
PROCESSED_STORAGE_PATH=./data/processed
CHUNKS_STORAGE_PATH=./data/chunks
