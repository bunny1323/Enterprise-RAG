# Application
APP_NAME=EnterpriseRAG
DEBUG=true
PORT=8000

# Voyage AI (REQUIRED - Only paid cloud API)
VOYAGE_API_KEY=pa-xxxxxxxx
VOYAGE_MODEL=voyage-multimodal-3.5
VOYAGE_TEXT_MODEL=voyage-3.5
# Weaviate Cloud (WCS)
WEAVIATE_URL=https://your-cluster.weaviate.network
WEAVIATE_API_KEY=xxxxxxxx 

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[password]@db.xxxxxxx.supabase.co:5432/postgres

# Neo4j Community (Local)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Ollama (Local Vision Model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:13b

# Local Storage Paths
RAW_STORAGE_PATH=./data/raw
PROCESSED_STORAGE_PATH=./data/processed
CHUNKS_STORAGE_PATH=./data/chunks
